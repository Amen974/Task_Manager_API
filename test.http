@baseUrl = http://localhost:3000

### ============================================
### 1. Register User A (will be workspace owner)
### ============================================
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "usera@example.com",
  "password": "password123",
  "name": "User A"
}

### Copy the access_token from the response into ownerToken below
@ownerToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjE3LCJpYXQiOjE3ODYyMzU5OTMsImV4cCI6MTc4NjIzNjg5M30.lr8j7R1dfMdEmXIU_x2LtGDc5PHWA6bIze8j3YmAiFU


### ============================================
### 2. Register User B (will be invited)
### ============================================
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "userb@example.com",
  "password": "password123",
  "name": "User B"
}

### Copy the access_token from the response into inviteeToken below
@inviteeToken = eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOjE4LCJpYXQiOjE3ODYyMzYwMDMsImV4cCI6MTc4NjIzNjkwM30.5VSe1eAMUwtZ0W_2bEdY2gCltntoZz0NCr9hb2Njk40


### ============================================
### 3. User A creates a workspace
### (auto-adds User A as 'owner' in members table)
### ============================================
POST {{baseUrl}}/workspaces
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "name": "Acme Corp"
}

### Check your DB or a GET endpoint (if you have one) to find the workspace id
@workspaceId = 5


### ============================================
### 4. User A invites User B's email
### Requires: owner/admin role (WorkspaceGuard + RequireRole)
### Sends email via Mailtrap sandbox
### ============================================
POST {{baseUrl}}/workspaces/{{workspaceId}}/invitations
Authorization: Bearer {{ownerToken}}
Content-Type: application/json

{
  "email": "userb@example.com"
}

### Now check your Mailtrap sandbox inbox in the dashboard
### Copy the token from the accept URL in the email body


### ============================================
### 5. User B accepts the invitation
### (must be logged in as User B — token from step 2)
### ============================================
POST {{baseUrl}}/workspaces/invitations/accept
Authorization: Bearer {{inviteeToken}}
Content-Type: application/json

{
  "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJlbWFpbCI6InVzZXJiQGV4YW1wbGUuY29tIiwid29ya3NwYWNlSWQiOjUsImlhdCI6MTc4NjIzNjAzNiwiZXhwIjoxNzg2ODQwODM2fQ.oa2drSqHvoCv5Mg6bDY0AariDFYRxVN-mB1siTPWfW0"
}

### ============================================
### 6. (Optional) Test decline instead — use a fresh
### invitation token, don't reuse an accepted one
### ============================================
POST {{baseUrl}}/invitations/decline
Content-Type: application/json

{
  "token": "PASTE_A_DIFFERENT_INVITATION_TOKEN_HERE"
}