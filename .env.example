# Server Configuration
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# PostgreSQL (Supabase)
POSTGRES_HOST=db.<project-ref>.supabase.co
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_supabase_password
POSTGRES_DB=postgres

# Redis & Message Queue (Upstash)
REDIS_PASSWORD=your_upstash_redis_password

# Authentication & JWT Secrets
ACCESS_TOKEN_SECRET=your_jwt_access_secret_key_minimum_32_characters
REFRESH_TOKEN_SECRET=your_jwt_refresh_secret_key_minimum_32_characters
INVITATION_TOKEN_SECRET=your_jwt_invitation_secret_key_minimum_32_characters

# Token Lifespans
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=1d
INVITATION_TOKEN_EXPIRES_IN=7d

# Mailtrap (Transactional Email Service)
API_TOKEN=your_mailtrap_api_token
MAILTRAP_TEST_INBOX_ID=your_mailtrap_inbox_id
MAIL_FROM_ADDRESS=noreply@taskmanager.com

# S3-Compatible Cloud Storage (Backblaze B2)
B2_Key_ID=your_backblaze_key_id
B2_ApplicationKey=your_backblaze_application_key
B2_Key_Name=your_b2_key_name
B2_Endpoint=https://s3.eu-central-003.backblazeb2.com
B2_Region=eu-central
B2_BUCKET_NAME=Task-Files
